# Cấu hình OpenCTI. Sao chép thành .env.opencti rồi điền. KHÔNG commit file thật.
#
# deploy/install-opencti.sh sinh file này tự động với bí mật ngẫu nhiên; bảng dưới đây
# dành cho ai muốn tự làm.

# Ghim phiên bản, không dùng :latest. Một lần docker pull vô tình sẽ nâng cấp cả nền
# tảng lẫn lược đồ Elasticsearch mà không ai chủ ý — và OpenCTI không hỗ trợ hạ cấp.
# Xem https://github.com/OpenCTI-Platform/opencti/releases
OPENCTI_VERSION=7.260907.0

# --- Tài khoản quản trị -----------------------------------------------------
OPENCTI_ADMIN_EMAIL=admin@vnnic.vn
OPENCTI_ADMIN_PASSWORD=

# Phải là UUIDv4:  uuidgen
# Đây đồng thời là API token của tài khoản quản trị, và hiện sync-consumer dùng chính nó
# để đọc Live Stream. Trước khi mở dịch vụ ra ngoài VNNIC phải tạo một service account
# riêng chỉ có quyền đọc stream: token quản trị mở toàn bộ kho tri thức tình báo, kể cả
# phần chưa công bố.
OPENCTI_ADMIN_TOKEN=

# openssl rand -base64 32
OPENCTI_ENCRYPTION_KEY=

# openssl rand -hex 16
OPENCTI_HEALTHCHECK_ACCESS_KEY=

# Cổng trên host. Không dùng 8080 vì blocklist-generator đã chiếm cổng đó.
OPENCTI_HOST_PORT=8081

# URL mà trình duyệt dùng để mở giao diện. Sai giá trị này thì đăng nhập chuyển hướng
# hỏng. Mặc định hợp với cách truy cập qua SSH tunnel.
OPENCTI_BASE_URL=http://localhost:8081

# --- Phụ thuộc --------------------------------------------------------------
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=

RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=

# Heap của Elasticsearch. Đặt bằng khoảng một nửa RAM dành cho ES và không quá 31G
# (trên ngưỡng đó JVM mất khả năng nén con trỏ, tốn bộ nhớ hơn mà không nhanh hơn).
ELASTIC_MEMORY_SIZE=4G

# Heap của nền tảng OpenCTI, tính bằng MB.
OPENCTI_NODE_HEAP=4096

# Worker là nơi nghẽn khi nhập lượng lớn indicator. Tăng khi stream lag leo.
OPENCTI_WORKER_REPLICAS=3

# --- ID của connector nội bộ ------------------------------------------------
# Mỗi cái là một UUIDv4 RIÊNG BIỆT:  uuidgen
# Hai connector trùng ID sẽ tranh nhau cùng một hàng đợi và cả hai cùng chạy sai.
CONNECTOR_EXPORT_FILE_STIX_ID=
CONNECTOR_EXPORT_FILE_CSV_ID=
CONNECTOR_EXPORT_FILE_TXT_ID=
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_DOCUMENT_ID=
CONNECTOR_OPENCTI_ID=
CONNECTOR_MITRE_ID=
