# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Mật khẩu PostgreSQL. Sinh bằng: openssl rand -base64 32
POSTGRES_PASSWORD=

# Email đăng ký chứng chỉ Let's Encrypt cho tip.cyberdns.vn.
# Let's Encrypt dùng địa chỉ này để cảnh báo khi chứng chỉ sắp hết hạn.
ACME_EMAIL=

# Mật khẩu admin của Grafana.
GRAFANA_PASSWORD=

# Nhãn phiên bản gắn vào binary và hiển thị ở metric cyberdns_build_info.
VERSION=dev

TIP_LOG_LEVEL=info
