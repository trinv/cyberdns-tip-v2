# Cấu hình cho compose.yaml ở gốc repo.
#
# KHÔNG bắt buộc: mọi biến dưới đây đều có mặc định trong compose.yaml, nên một repo
# vừa clone chạy được ngay bằng "docker compose up -d". File này để cố định mật khẩu
# và bật OpenCTI.
#
# Cách nhanh nhất là để script sinh giúp, kèm bí mật ngẫu nhiên:
#
#     ./deploy/lab.sh up          # sinh .env rồi khởi động
#     ./deploy/lab.sh opencti     # bổ sung phần OpenCTI vào cùng file .env
#
# Làm tay thì: cp .env.example .env rồi điền. KHÔNG commit .env.

# ----------------------------------------------------------------- lõi

# Mật khẩu của volume dữ liệu PostgreSQL.
#
# Đổi giá trị này khi volume đã có dữ liệu sẽ khiến PostgreSQL không mở được dữ liệu
# cũ — đó là kiểu mất dữ liệu không có cách nào lần ngược. Chỉ đổi cùng lúc với
# "docker compose down -v".
POSTGRES_PASSWORD=

# Tài khoản quản trị đầu tiên, do service bootstrap tạo.
#
# Đặt TIP_ADMIN_PASSWORD để mật khẩu ỔN ĐỊNH qua mỗi lần "down -v". Bỏ trống thì
# bootstrap sinh ngẫu nhiên và in ra nhật ký của chính nó — đọc bằng:
#     docker compose logs bootstrap
#
# Bootstrap KHÔNG bao giờ đụng tới tài khoản đã tồn tại, nên đổi mật khẩu trên
# dashboard sẽ không bị ghi đè ở lần khởi động sau.
TIP_ADMIN_EMAIL=admin@vnnic.vn
TIP_ADMIN_PASSWORD=

# Cổng trên máy host. Đổi nếu trùng với dịch vụ khác.
LAB_BLOCKLIST_PORT=8443
LAB_ADMIN_PORT=9443
LAB_OPENCTI_PORT=10443
LAB_POSTGRES_PORT=55433

# Chu kỳ chạy. Ngắn để thấy kết quả nhanh khi thử nghiệm; production dùng hàng giờ.
TIP_INGEST_INTERVAL=30m
TIP_POLICY_INTERVAL=10m
TIP_BUILD_INTERVAL=5m
TIP_LOG_LEVEL=info

# ----------------------------------------------------------------- OpenCTI (tùy chọn)
#
# Bỏ comment cả khối để bật. Cần thêm khoảng 16 GB RAM và:
#     sudo sysctl -w vm.max_map_count=262144
#
# Dễ hơn: chạy ./deploy/lab.sh opencti — nó sinh mọi bí mật rồi bổ sung vào .env.

# Để "docker compose" trần nạp luôn lớp phủ OpenCTI. Đường dẫn tính từ thư mục bạn
# đang đứng, nên hãy chạy docker compose ở gốc repo.
#COMPOSE_FILE=compose.yaml:deploy/docker-compose/docker-compose.opencti.yml

#OPENCTI_VERSION=7.260907.0
#OPENCTI_ADMIN_EMAIL=admin@vnnic.vn
#OPENCTI_ADMIN_PASSWORD=
# Phải là UUIDv4:  uuidgen
#OPENCTI_ADMIN_TOKEN=
# openssl rand -base64 32 — SAO LƯU: mất khóa này là không giải mã được dữ liệu đã lưu.
#OPENCTI_ENCRYPTION_KEY=
#OPENCTI_HEALTHCHECK_ACCESS_KEY=
#OPENCTI_HOST_PORT=8081
#OPENCTI_BASE_URL=https://localhost:10443

# sync-consumer đọc hai biến này. Token phải trùng OPENCTI_ADMIN_TOKEN ở trên.
#
# Trước khi mở dịch vụ ra ngoài VNNIC, hãy tạo một service account riêng chỉ có quyền
# đọc stream: token quản trị mở toàn bộ kho tri thức tình báo, kể cả phần chưa công bố.
#TIP_OPENCTI_URL=http://opencti:8080
#TIP_OPENCTI_TOKEN=
# Rỗng nghĩa là nghe stream mặc định. Tạo stream riêng trong OpenCTI ở
# Data > Data sharing > Live streams rồi dán id vào đây nếu cần lọc.
#TIP_OPENCTI_STREAM_ID=

#MINIO_ROOT_USER=opencti
#MINIO_ROOT_PASSWORD=
#RABBITMQ_DEFAULT_USER=opencti
#RABBITMQ_DEFAULT_PASS=

# Cấu hình gọn cho lab. Production cần nhiều hơn.
#ELASTIC_MEMORY_SIZE=2G
#OPENCTI_NODE_HEAP=2048
#OPENCTI_WORKER_REPLICAS=1

# Mỗi connector một UUID riêng: trùng id thì hai connector tranh nhau cùng hàng đợi.
#CONNECTOR_EXPORT_FILE_STIX_ID=
#CONNECTOR_EXPORT_FILE_CSV_ID=
#CONNECTOR_EXPORT_FILE_TXT_ID=
#CONNECTOR_IMPORT_FILE_STIX_ID=
#CONNECTOR_IMPORT_DOCUMENT_ID=
#CONNECTOR_OPENCTI_ID=
#CONNECTOR_MITRE_ID=
